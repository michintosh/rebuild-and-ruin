# Default online server host (host[:port], no protocol). Defaults to localhost:8001.
VITE_SERVER_HOST=localhost:8001

# Port for `npm run preview` / `yarn preview` (Vite default: 4173).
PREVIEW_PORT=4173

# Comma-separated hostnames `vite preview` accepts (default: rampart.maremosso.net).
PREVIEW_ALLOWED_HOSTS=rampart.maremosso.net
